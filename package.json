{
  "name": "@aoc-enterprise/runtime",
  "private": true,
  "version": "1.5.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b --pretty false",
    "lint": "node scripts/check-node16-imports.mjs && node scripts/lint-architecture.mjs && node scripts/lint-public-surface.mjs",
    "test": "npm run build && node --test \"dist/src/**/*.test.js\" \"tests/**/*.test.mjs\" && npm test --workspaces --if-present",
    "test:root": "node --test \"dist/src/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "test:workspaces": "npm test --workspaces --if-present",
    "start:enterprise": "node scripts/run-enterprise-host.mjs",
    "start:kernel-host": "node scripts/run-enterprise-host.mjs",
    "demo:commercial": "npm run demo --workspace=@aoc-enterprise/commercial-demo",
    "clean": "node scripts/clean.mjs",
    "validate:invalid-imports": "node scripts/assert-invalid-imports.mjs",
    "validate:publishability": "node scripts/validate-publishability.mjs",
    "check:protocol-consumption": "node scripts/check-protocol-consumption.mjs",
    "check:protocol-contract-adoption": "node scripts/check-protocol-contract-adoption.mjs",
    "check:runtime-state": "node scripts/check-runtime-operational-state.mjs",
    "check:runtime-persistence": "node scripts/check-runtime-persistence.mjs",
    "check:runtime-federation": "npm run build --silent && node scripts/check-runtime-federation.mjs",
    "check:runtime-vault": "node scripts/check-runtime-vault-boundary.mjs",
    "check:aoc-boundaries": "node scripts/check-aoc-boundaries.mjs",
    "check:release-integrity": "node scripts/check-runtime-release-integrity.mjs",
    "check:clean-room-consumer": "node scripts/release/check-clean-room-consumer.mjs",
    "protocol:tarball:build": "node scripts/protocol/build-protocol-tarball.mjs",
    "protocol:tarball:validate": "node scripts/protocol/validate-enterprise-against-protocol-tarball.mjs",
    "protocol:tarball:verify-lock": "node scripts/protocol/verify-tarball-against-lock.mjs",
    "check:protocol-compatibility-lock": "node scripts/protocol/check-compatibility-lock.mjs",
    "check:protocol-canonicalization": "node scripts/protocol/check-canonicalization-regression.mjs",
    "legal:check": "node scripts/validate-legal-ip.mjs --mode=report",
    "legal:check:strict": "node scripts/validate-legal-ip.mjs --mode=strict",
    "backup:v1": "node scripts/portability/backup-enterprise-v1.mjs",
    "restore:v1": "node scripts/portability/restore-enterprise-v1.mjs",
    "fixture:portability:v1": "node scripts/portability/generate-portability-fixture.mjs",
    "compare:portability:v1": "node scripts/portability/compare-portability-state.mjs",
    "check:portability-smoke": "node scripts/portability/check-portability-smoke.mjs",
    "validate:portability:v1": "node scripts/portability/validate-portability-v1.mjs",
    "validate:release": "npm run typecheck && npm run build && npm run lint && npm test && npm run check:protocol-consumption && npm run check:protocol-contract-adoption && npm run check:protocol-compatibility-lock && npm run check:runtime-state && npm run check:runtime-persistence && npm run check:runtime-vault && npm run check:aoc-boundaries && npm run validate:publishability && npm run check:release-integrity && npm run check:clean-room-consumer",
    "validate:v1-release": "npm run typecheck && npm run lint && npm test && npm run check:protocol-consumption && npm run check:protocol-contract-adoption && npm run check:protocol-compatibility-lock && npm run check:runtime-state && npm run check:runtime-persistence && npm run check:runtime-federation && npm run check:runtime-vault && npm run check:aoc-boundaries && npm run check:release-integrity && npm run check:clean-room-consumer && npm run validate:publishability && node scripts/check-api-freeze.mjs && node scripts/verify-release-manifest.mjs && node scripts/check-release-docs.mjs && node scripts/check-sdk-surface.mjs && npm run check:portability-smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./authorization": {
      "types": "./dist/src/runtime/authorization/index.d.ts",
      "default": "./dist/src/runtime/authorization/index.js"
    },
    "./audit": {
      "types": "./dist/src/runtime/audit/index.d.ts",
      "default": "./dist/src/runtime/audit/index.js"
    },
    "./crypto": {
      "types": "./dist/src/runtime/crypto/index.d.ts",
      "default": "./dist/src/runtime/crypto/index.js"
    },
    "./adapters": {
      "types": "./dist/src/runtime/adapters/index.d.ts",
      "default": "./dist/src/runtime/adapters/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    },
    "./runtime-host": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    },
    "./kernel": {
      "types": "./dist/src/kernel/index.d.ts",
      "default": "./dist/src/kernel/index.js"
    },
    "./enterprise": {
      "types": "./dist/src/enterprise/index.d.ts",
      "default": "./dist/src/enterprise/index.js"
    },
    "./kernel-host": {
      "types": "./dist/src/kernel-host/index.d.ts",
      "default": "./dist/src/kernel-host/index.js"
    }
  },
  "peerDependencies": {
    "@aoc/protocol": ">=0.1.0 || >=0.2.0-rc.0",
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@aoc-enterprise/governed-authority": "*",
    "@aoc-enterprise/governed-authorization": "*",
    "@aoc-enterprise/identity": "*",
    "@aoc-enterprise/scoped-access": "*",
    "better-sqlite3": "^12.11.1"
  },
  "bundleDependencies": [
    "@aoc-enterprise/governed-authority",
    "@aoc-enterprise/governed-authorization",
    "@aoc-enterprise/identity",
    "@aoc-enterprise/scoped-access"
  ],
  "devDependencies": {
    "@aoc-enterprise/pmfreak-agent-passport-foundation": "*",
    "@aoc/protocol": "file:./vendor/aoc-protocol-0.2.0-rc.1.tgz",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
