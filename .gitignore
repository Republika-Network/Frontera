node_modules
.next
dist
dist-test
build
coverage
.env
.env.local
.env.*
# ...except committed example/reference files -- ".env.*" above would
# otherwise silently hide every ".env.example" from Git, defeating their
# purpose as tracked, secret-free configuration documentation (Phase 17 of
# docs/release/AOC_ENTERPRISE_V1_PORTABILITY_REPORT.md).
!.env.example
!**/.env.example
.vercel
turbo
.DS_Store
*.log
*.tsbuildinfo

# Generated output from `npm run demo` (packages/commercial-demo) -- a fresh
# HTML/Markdown report per run, not a tracked artifact.
packages/commercial-demo/demo-output/
.claude/worktrees/

# Agent Passport SQLite data directory
apps/agent-passport-web/.data/

.data/

# npm pack output (validate-publishability)
*.tgz

# Exception: the vendored @aoc/protocol tarball is a tracked, checksummed
# build artifact (see protocol-consumer.lock.json) -- it is the canonical
# interim dependency artifact until @aoc/protocol is published to a
# registry (docs/integration/PROTOCOL_PACKAGE_CONSUMPTION.md, "Registry
# transition"), not disposable pack output.
!/vendor/*.tgz

# Exception: the vendored Soberanía runtime artifacts are tracked, checksummed build artifacts
# pinned by soberania-runtime-consumer.lock.json (docs/integration/SOBERANIA_RUNTIME_CONSUMPTION.md).
!/vendor/soberania-runtime/*.tgz

# Real backups produced by `npm run backup:v1` / restore targets / drill
# scratch output -- never commit an actual backup (see
# docs/operations/AOC_ENTERPRISE_BACKUP_V1.md, "Security"). Fixture and
# contract-test backups are written under the OS temp directory, not here,
# so they are unaffected by this rule.
/backups/
*.aoc-enterprise-backup/
/.portability-drill/
restore-report.json
backup-manifest.json
fixture-manifest.json
portability-comparison.json
clean-room-drill-report.json
