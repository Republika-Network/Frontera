# Soberanía Enterprise Host — Environment Variables (v1.0.0)
#
# Every variable `loadEnterpriseConfiguration()` reads
# (src/enterprise/configuration/enterprise-configuration.ts), with no
# value from a real deployment. Copy relevant lines into your own process
# environment / secret manager -- never commit a filled-in copy of this
# file with real values.
#
# Classification used below:
#   required-prod   = must be set for any non-local/production deployment
#   required-local  = needed to run the Host locally at all beyond defaults
#   required-test   = needed by the clean-room drill / CI test defaults
#   optional        = has a safe default; only set to override it
#   secret          = never log, never back up, never commit a real value
#   defaulted       = always has a fallback; safe to omit entirely
#   prohibited-from-backup = must never appear in a backup (see
#                            docs/operations/AOC_ENTERPRISE_BACKUP_V1.md)
#
# ---- How the Host starts (PROD-01) ----
# `npm run start:enterprise` boots through the canonical bootstrap
# (src/enterprise/host/enterprise-host.ts). It reads every variable STRICTLY:
# an unrecognized AOC_ENTERPRISE_ENV, persistence provider, boolean, log level
# or port refuses to boot instead of falling back to a default.
#
# Two profiles, chosen by AOC_ENTERPRISE_ENV:
#
#   development / test   Explicit, possibly insecure by design. Defaults to
#                        ephemeral in-memory state and a loopback-only bind.
#                        /health `posture` says `ephemeral`; the launcher
#                        prints a WARNING.
#
#   production / staging The secure profile. The Host refuses to boot unless:
#                        - AOC_ENTERPRISE_PERSISTENCE_PROVIDER=sqlite (explicit)
#                        - AOC_ENTERPRISE_REQUIRE_AUTH=true with credentials
#                        - AOC_ENTERPRISE_KERNEL_AUTHORITY_ENABLED=true and
#                          AOC_ENTERPRISE_KERNEL_AUTHORITY_REQUIRED=true
#                        - the authority signing key + trusted verification set
#                        - AOC_ENTERPRISE_GOVERNED_ACTIONS_FILE (see below)
#                        and, after composition, unless the signed grant store
#                        verifies and every required module is healthy.
#
# In every profile: a Host with authentication off may only bind loopback.
#
# Minimum secure production host (values are placeholders, not credentials):
#   AOC_ENTERPRISE_ENV=production
#   AOC_ENTERPRISE_PERSISTENCE_PROVIDER=sqlite
#   AOC_ENTERPRISE_REQUIRE_AUTH=true
#   AOC_ENTERPRISE_HTTP_HOST=0.0.0.0            # or 127.0.0.1 behind a proxy
#   AOC_ENTERPRISE_KERNEL_AUTHORITY_ENABLED=true
#   AOC_ENTERPRISE_KERNEL_AUTHORITY_ORGANIZATION_ID=org-acme
#   AOC_ENTERPRISE_AUTHORITY_SIGNING_KEY_ID=...  AOC_ENTERPRISE_AUTHORITY_VERIFICATION_KEYS='[...]'
#   + ONE authority-key custody (CORE-02):
#       external: AOC_ENTERPRISE_AUTHORITY_SIGNER_MODE=external + _SIGNER_ENDPOINT + _SIGNER_TOKEN
#                 (no private key in this process), or
#       software: AOC_ENTERPRISE_AUTHORITY_SIGNING_KEY_PEM=... (key in process memory, AA-001)
#   + an external authority-state freshness witness (CORE-07, required):
#       AOC_ENTERPRISE_AUTHORITY_FRESHNESS_MODE=external + _FRESHNESS_ENDPOINT + _FRESHNESS_TOKEN
#       + _FRESHNESS_WITNESS_ID + _FRESHNESS_WITNESS_PUBLIC_KEY
#   AOC_ENTERPRISE_GOVERNED_ACTIONS_FILE=/etc/frontera/governed-actions.json
#   + every *_SQLITE_PATH below on a persistent volume
#   + the secret variables the governed-action file names

# ---- Environment / identity (optional, defaulted) ----
AOC_ENTERPRISE_ENV=development
AOC_ENTERPRISE_VERSION=1.0.0
AOC_ENTERPRISE_LOG_LEVEL=info

# ---- Persistence provider (required-prod: "sqlite"; defaulted to "memory") ----
# "memory" (default) keeps nothing durable and loses all state on
# restart -- backup:v1/restore:v1 refuse to run against it, and the Host
# refuses it under AOC_ENTERPRISE_ENV=production/staging.
AOC_ENTERPRISE_PERSISTENCE_PROVIDER=memory

# Independent SQLite store paths (required-prod when provider=sqlite;
# defaulted to .data/*.sqlite for local development). Every *_SQLITE_PATH
# below is one store in the PROD-02 portability registry
# (scripts/portability/store-registry.mjs): backup:v1 backs up each store
# the deployment composes, and restore:v1 writes each under the default
# basename shown here. Never point any of them at the freshness witness's
# database, which belongs to a different restore domain (CORE-07).
AOC_ENTERPRISE_SQLITE_PATH=.data/enterprise-host.sqlite
AOC_ENTERPRISE_PASSPORT_SQLITE_PATH=.data/agent-passport.sqlite
AOC_ENTERPRISE_ASSURANCE_SQLITE_PATH=.data/assurance.sqlite
AOC_ENTERPRISE_KERNEL_AUTHORITY_SQLITE_PATH=.data/kernel-authority.sqlite

# Governed-action stores (required-prod when provider=sqlite). Each is its own
# file, opened only when governed actions are composed. Covered by backup:v1
# (PROD-02). EXECUTION_RESOLUTION is composed only by an embedder (P12); it is
# backed up when this variable is set and the file exists.
AOC_ENTERPRISE_BOUNDED_GRANT_SQLITE_PATH=.data/bounded-grants.sqlite
AOC_ENTERPRISE_EMERGENCY_CONTROL_SQLITE_PATH=.data/emergency-controls.sqlite
AOC_ENTERPRISE_EXERCISE_LEDGER_SQLITE_PATH=.data/exercise-ledger.sqlite
AOC_ENTERPRISE_AUTHORITY_EVENT_STREAM_SQLITE_PATH=.data/authority-event-stream.sqlite
AOC_ENTERPRISE_EXECUTION_OUTCOME_SQLITE_PATH=.data/execution-outcomes.sqlite
AOC_ENTERPRISE_EXECUTION_RESOLUTION_SQLITE_PATH=.data/execution-resolutions.sqlite
# CORE-04: the append-only obligation discharge store, opened only when the
# governed-action file declares obligation discharge sources. Signed and
# CORE-07 anchored; covered by backup:v1 (PROD-02).
AOC_ENTERPRISE_OBLIGATION_DISCHARGE_SQLITE_PATH=.data/obligation-discharges.sqlite
# CORE-05: the append-only, signed approval store (approval requests and
# approver verdicts that resume withheld decisions), opened only when a
# Governance Profile declares an approval requirement. Signed head and rows are
# backed up together, as one file, by backup:v1 (PROD-02).
AOC_ENTERPRISE_APPROVAL_SQLITE_PATH=.data/approvals.sqlite
# CTRL-02: the control-plane store — operator-issued agent credentials (SHA-256
# verifiers only, never secrets) and the Governance Profile lifecycle. Opened
# only when the governed-action file declares "operators". Append-only (SQLite
# triggers). Covered by backup:v1 (PROD-02) but NOT witness-anchored: after a
# restore, re-apply credential revocations and profile retirements made since
# the backup (docs/operations/RUNBOOKS_V1.md section 5.2).
AOC_ENTERPRISE_CONTROL_PLANE_SQLITE_PATH=.data/control-plane.sqlite
# ASSURE-01: the durable Evidence Bundle Store — v1 decision bundles and v2
# Unified Authority-to-Outcome Trace bundles, with their lifecycle. Opened
# whenever persistence is sqlite (the secure profile refuses an in-memory one).
# Its own file, never the Governance Store. Covered by backup:v1.
AOC_ENTERPRISE_EVIDENCE_SQLITE_PATH=.data/evidence-bundles.sqlite

# ---- Authority artifact authenticity (required with the durable grant store) ----
# Bounded grants and grant revocations persisted by the durable bounded-grant
# store carry a detached Ed25519 signature, verified on every authoritative
# read. See docs/security/AUTHORITY_ARTIFACT_AUTHENTICITY.md.
#
# There is no unsigned mode and no flag that disables verification. If
# AOC_ENTERPRISE_PERSISTENCE_PROVIDER=sqlite and a host composes
# authorityControlledExecution, these MUST be set or composition fails closed.
#
# Two custodies for the authority signing key (CORE-02). Choose exactly one.
#
# --- external custody (no authority private key in this process) ---
# The key lives in a separate custody service speaking the structured
# frontera.external-authority-signer.v1 protocol. This process holds only the
# endpoint, a service credential, the pinned key id and the trusted PUBLIC keys.
# At startup the service must answer as exactly the pinned key (key id,
# algorithm and public key from AOC_ENTERPRISE_AUTHORITY_VERIFICATION_KEYS) or
# the Host refuses to start. Every signature is verified locally before use.
# Reads keep working if the signer goes down; issuance, revocation, obligation
# discharge and approval fail and write nothing (a revocation is reported as
# NOT recorded -- use an emergency stop to halt execution meanwhile).
#
# AOC_ENTERPRISE_AUTHORITY_SIGNER_MODE=external
# AOC_ENTERPRISE_AUTHORITY_SIGNER_ENDPOINT=https://authority-signer.internal.example:8443
#   (https; plain http is accepted only to a loopback address -- the local
#    reference signer, `npm run start:reference-authority-signer`, which is
#    NOT an HSM)
# AOC_ENTERPRISE_AUTHORITY_SIGNER_TOKEN=<secret, >= 32 chars>   # authorizes USE of the key; not the key
# AOC_ENTERPRISE_AUTHORITY_SIGNER_TIMEOUT_MS=5000               # per attempt, 1..60000
# AOC_ENTERPRISE_AUTHORITY_SIGNER_MAX_ATTEMPTS=2                # 1..3, startup identity and every signature;
#                                                               #   only availability failures retry (no delay;
#                                                               #   worst case TIMEOUT_MS x MAX_ATTEMPTS)
# AOC_ENTERPRISE_AUTHORITY_SIGNER_PROBE_INTERVAL_MS=5000        # 0..60000; /health re-probes identity at most
#                                                               #   this often (single-flight; 0 = every check).
#                                                               #   A signing failure shows at once regardless.
#
# In external mode AOC_ENTERPRISE_AUTHORITY_SIGNING_KEY_PEM MUST NOT be set --
# neither in the configuration nor anywhere in the Host process environment:
# the Host refuses to start rather than ignore a key left in its environment.
# External-signer variables without AOC_ENTERPRISE_AUTHORITY_SIGNER_MODE=external
# are refused too. There is no fallback between custodies.
#
# --- software custody (the historical default when no mode is set) ---
# AOC_ENTERPRISE_AUTHORITY_SIGNING_KEY_PEM is a SECRET (PKCS#8 private key). It
# is redacted from the public configuration surface. It is held in application
# process memory -- finding AA-001. Treat it exactly as you treat API keys.
#
# Generate a key pair with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');
#   console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
#
# The values below are NON-PRODUCTION PLACEHOLDERS ("..." is not key material).
# Never commit a real private key; generate one per deployment as shown above.
# AOC_ENTERPRISE_AUTHORITY_SIGNING_KEY_ID=authority-key-2026-01
# AOC_ENTERPRISE_AUTHORITY_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# The trusted verification set: JSON, public material only. It must contain the
# active signing key, and it should RETAIN retired keys for as long as any
# artifact they signed is still live -- removing one makes those artifacts
# unreadable, which is a key-trust decision and NOT a revocation.
# AOC_ENTERPRISE_AUTHORITY_VERIFICATION_KEYS='[{"keyId":"authority-key-2026-01","algorithm":"ed25519-v1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}]'

# ---- Authority-state freshness (CORE-07; required-prod: "external") ----
# A signature proves a durable authority state is authentic, never that it is
# the NEWEST: without this, restoring a pre-revocation copy of the grant
# database brings a revoked grant back after a restart. With "external", the
# signed head of every durable authority store (grants' revocation state,
# obligation discharges, approvals) is anchored at an external witness, and a
# store restored behind it refuses to open -- the Host does not start.
#
# DEPLOYMENT RULE: the witness's state MUST live on a different volume, in a
# different backup set and on a different snapshot schedule from every
# authority database below. Restoring both together to the same earlier moment
# is undetectable.
#
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_MODE=external              # none | external (absent = none; production/staging require external)
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_ENDPOINT=https://authority-witness.internal.example:8444
#   (base URL; https, or plain http only to a loopback address -- the local
#    reference witness, `npm run start:reference-authority-state-witness`,
#    which is NOT a ledger, an HSM or a timestamping authority)
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_TOKEN=<secret, >= 32 chars>   # its OWN credential; never the signer token
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_WITNESS_ID=witness-prod-1      # the pinned witness id every receipt must name
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_WITNESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
#                                                               #   the witness's Ed25519 receipt key (public; from
#                                                               #   the witness's <key>.pub, installed by you -- never
#                                                               #   learned from the witness; never an authority key)
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_TIMEOUT_MS=5000            # per attempt, 1..60000
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_MAX_ATTEMPTS=2             # 1..3; only availability failures retry
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_PROBE_INTERVAL_MS=5000     # 0..60000; /health asks the witness at most this often
#
# Witness down at startup: the Host does not start. Down later: existing
# authority keeps reading (Host degraded); revocation, obligation discharge and
# approval are refused and write nothing. Existing stores are never enrolled
# automatically -- run scripts/enroll-authority-state-freshness.mjs once (see
# docs/enterprise/AOC_ENTERPRISE_HOST.md). Witness variables without
# AOC_ENTERPRISE_AUTHORITY_FRESHNESS_MODE=external are refused.

# ---- Governed actions (required-prod) ----
# Path to the governed-action deployment file: trust domain, grant lifetime,
# customer principals, trusted monetary assets, Generic HTTP adapters and the
# action -> adapter routes. Schema and a reviewed example:
#   examples/enterprise-host/governed-actions.example.json
#   docs/enterprise/AOC_ENTERPRISE_HOST.md "Secure production host"
# The file holds NO secrets. Each secret is named by the environment variable
# that holds it ("apiKeyEnv", "tokenEnv", "valueEnv"); an inline secret is
# refused. With the example file you would also set, in your secret manager:
#   FRONTERA_CUSTOMER_KEY_AGENT_1=<customer principal API key>
#   FRONTERA_ERP_API_TOKEN=<provider credential>
#
# Authority administration (CTRL-01, optional): add to the file
#   "administrators": [{ "operatorId": "ops-oncall-1", "apiKeyEnv": "FRONTERA_ADMIN_KEY_ONCALL_1" }]
# and set, in your secret manager, a long random secret (>= 32 characters):
#   FRONTERA_ADMIN_KEY_ONCALL_1=<administrator secret, e.g. openssl rand -base64 48>
# An administrator secret authenticates /api/admin/... ONLY; no ordinary API
# key reaches those routes. There is no default administrator: without
# "administrators" the administration API is not mounted.
# See docs/enterprise/AOC_AUTHORITY_ADMINISTRATION_API.md.
#
# Operators (CTRL-02, optional): identified human operators with one role each
# from the closed model (observer, responder, provisioner, profile-steward,
# organization-administrator). Add to the file
#   "operators": [{ "operatorId": "ops-alice", "role": "provisioner", "apiKeyEnv": "FRONTERA_OPERATOR_KEY_ALICE" }]
# and set a long random secret (>= 32 characters) for each. With operators
# configured, agents are onboarded over /api/admin/... (no static
# "customerPrincipals" is required) and receive operator-issued credentials.
# A CTRL-01 administrator keeps exactly its CTRL-01 powers and never provisions;
# migrate a person by declaring them under "operators" instead. Optional:
#   "profileLifecycle": "operator-promoted"
# makes governance.profiles a catalog that only a profile-steward or
# organization-administrator can activate. See
# docs/architecture/ADR-CTRL-02-OPERATOR-AGENT-IDENTITY.md.
# Unset in development = no governed-action route (evaluate-only Host).
# AOC_ENTERPRISE_GOVERNED_ACTIONS_FILE=/etc/frontera/governed-actions.json

# ---- Durable Kernel Authority (required with governed actions) ----
# The operator-provisioned recognition/authority world AocKernel decides
# against. See docs/enterprise/AOC_DURABLE_KERNEL_AUTHORITY.md.
#
# Off by default. Off, the Kernel composes a real but EMPTY world and denies
# every request until a deployment provisions one -- that is the historical,
# fail-closed behaviour and it is unchanged. On, the Kernel's world is
# restored from AOC_ENTERPRISE_KERNEL_AUTHORITY_SQLITE_PATH at startup.
#
# Turning this on does not by itself allow anything: an enabled-but-empty
# authority source denies exactly as an unconfigured deployment does.
AOC_ENTERPRISE_KERNEL_AUTHORITY_ENABLED=false

# The organization whose authority world this deployment decides for. One
# Enterprise instance serves exactly one authority organization; a request
# naming a different organization is denied rather than answered out of the
# wrong world.
AOC_ENTERPRISE_KERNEL_AUTHORITY_ORGANIZATION_ID=default

# ---- Store tuning (optional, defaulted) ----
AOC_ENTERPRISE_STORE_BUSY_TIMEOUT_MS=5000
AOC_ENTERPRISE_STORE_MAX_REQUEST_PAYLOAD_BYTES=262144
AOC_ENTERPRISE_STORE_MAX_RESULT_PAYLOAD_BYTES=524288
AOC_ENTERPRISE_STORE_MAX_EVENT_PAYLOAD_BYTES=65536
AOC_ENTERPRISE_STORE_MAX_TRACE_STEPS=500

# ---- Events / telemetry (optional, defaulted to enabled) ----
AOC_ENTERPRISE_EVENTS_ENABLED=true
AOC_ENTERPRISE_TELEMETRY_ENABLED=true

# ---- Authentication (secret; required-prod) ----
# Comma-separated "key" or "key:organizationId" pairs for the legacy v1
# routes. Customer principals for POST /api/governed-actions are configured
# in the governed-action file instead. There is no default key. NEVER set a
# real value here, NEVER back this up (backup:v1 never reads it), NEVER
# commit a filled-in copy of this file.
AOC_ENTERPRISE_API_KEYS=

# ---- Feature flags ----
AOC_ENTERPRISE_TRACE_LEVEL=basic
# required-prod: true. Off is development-only and forces a loopback bind.
AOC_ENTERPRISE_REQUIRE_AUTH=false

# ---- HTTP listener ----
AOC_ENTERPRISE_HTTP_PORT=8787
# Defaults to loopback. A network bind (e.g. 0.0.0.0) is refused unless
# AOC_ENTERPRISE_REQUIRE_AUTH=true.
AOC_ENTERPRISE_HTTP_HOST=127.0.0.1

# ---- Lifecycle timeouts, ms (optional, defaulted) ----
AOC_ENTERPRISE_STARTUP_TIMEOUT_MS=30000
AOC_ENTERPRISE_SHUTDOWN_TIMEOUT_MS=30000
AOC_ENTERPRISE_HEALTH_CHECK_TIMEOUT_MS=5000

# ---- Optional module criticality (optional, defaulted to false = degrade, not fail) ----
AOC_ENTERPRISE_PASSPORT_REQUIRED=false
AOC_ENTERPRISE_ASSURANCE_REQUIRED=false

# Kernel Authority defaults to TRUE, unlike its siblings: an authority source
# that is silently absent is not a degraded feature, it is a Host answering out
# of a world it can no longer verify. Only consulted when
# AOC_ENTERPRISE_KERNEL_AUTHORITY_ENABLED=true.
AOC_ENTERPRISE_KERNEL_AUTHORITY_REQUIRED=true

# ---- Clean-room drill / portability tooling test defaults (required-test) ----
# The synthetic portability fixture (scripts/portability/generate-portability-fixture.mjs)
# and the clean-room drill (scripts/portability/validate-portability-v1.mjs)
# set AOC_ENTERPRISE_PERSISTENCE_PROVIDER=sqlite and the four
# *_SQLITE_PATH variables above programmatically, pointed at a temporary
# directory -- no manual .env setup is required to run
# `npm run validate:portability:v1` or `npm run check:portability-smoke`.
