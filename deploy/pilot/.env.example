# Frontera pilot deployment kit — site settings and secrets (PROD-03-03).
#
#   cp .env.example .env      then edit .env; never commit it (it is gitignored).
#
# The kit fixes the security-relevant settings itself (compose.yaml,
# `environment:`): the production profile, SQLite persistence, required
# authentication, the listener and every store path under /var/lib/frontera.
# This file holds only what differs per site. The full variable reference is
# the repository's root .env.example; the guide is
# docs/deployment/PILOT_DEPLOYMENT.md.
#
# Lines marked REQUIRED must be replaced before startup. A value still of the
# form <required...> is refused by the config check and by the Host's launcher.
# Use your secret manager or deployment tooling to produce this file if you
# have one; the Host reads plain environment variables and nothing else.

# ---- Identity of this deployment (REQUIRED) ----
# The organization this Host decides for. One Host serves one organization.
AOC_ENTERPRISE_KERNEL_AUTHORITY_ORGANIZATION_ID=<required: organization id, e.g. org-acme>

# ---- Provider credential (REQUIRED, SECRET) ----
# The secret governed-actions.json names in "tokenEnv". Issued by your provider;
# it is not generated here.
FRONTERA_PROVIDER_TOKEN=<required-secret>

# ---- Generated secrets (REQUIRED, SECRET) ----
# Not listed here: run the generator ONCE (docs/deployment/PILOT_DEPLOYMENT.md,
# step 4). It appends to this file the authority signing key, its verification
# set, the witness id, credential and public key, and one random credential per
# operator the governed-action file names (FRONTERA_OPERATOR_KEY_ADMIN,
# FRONTERA_OPERATOR_KEY_OBSERVER in the example).

# ---- Optional ----
# Where the Host's port is published on this machine (default 127.0.0.1:8787).
# Keep it on loopback or a private interface; terminate TLS in front of it.
# FRONTERA_PUBLISH_ADDRESS=127.0.0.1
# FRONTERA_PUBLISH_PORT=8787
# AOC_ENTERPRISE_LOG_LEVEL=info
# AOC_ENTERPRISE_SHUTDOWN_TIMEOUT_MS=30000
# Make the optional modules required (default false = degrade, not fail):
# AOC_ENTERPRISE_PASSPORT_REQUIRED=false
# AOC_ENTERPRISE_ASSURANCE_REQUIRED=false
