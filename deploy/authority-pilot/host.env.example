# Frontera Authority synthetic pilot — HOST machine settings (AUTH-04D2A).
#
#   cp deploy/authority-pilot/host.env.example deploy/pilot/.env
#
# The PROD-03 kit reads deploy/pilot/.env. Never commit it. Prefer rendering it
# from the secret manager at start and keeping it off disk otherwise.
# Lines marked REQUIRED must be replaced; a value still of the form <required...>
# is refused by the config check and by the Host's launcher.
#
# Deliberately ABSENT: COMPOSE_PROFILES=reference-witness. The witness runs on
# its own machine (compose.witness.yaml); the bundled one must never start here.

# ---- Identity of this deployment (REQUIRED) ----
# A synthetic organization. One Host serves one organization.
AOC_ENTERPRISE_KERNEL_AUTHORITY_ORGANIZATION_ID='<required: synthetic organization id, e.g. org-frontera-synthetic-pilot>'

# ---- The remote CORE-07 witness (REQUIRED) ----
# Its https endpoint (the witness machine's TLS ingress), and the three values
# its `witness-init --witness-only` printed. The token is SECRET.
AOC_ENTERPRISE_AUTHORITY_FRESHNESS_ENDPOINT='<required: https://witness host name>'
AOC_ENTERPRISE_AUTHORITY_FRESHNESS_WITNESS_ID='<required: from witness-init --witness-only>'
AOC_ENTERPRISE_AUTHORITY_FRESHNESS_TOKEN='<required-secret: from witness-init --witness-only>'
AOC_ENTERPRISE_AUTHORITY_FRESHNESS_WITNESS_PUBLIC_KEY='<required: from witness-init --witness-only>'

# ---- Generated on THIS machine (REQUIRED, SECRET) ----
# Not listed here: run `authority-init` once (docs/deployment/AUTHORITY_PILOT_DEPLOYMENT.md §10,
# step 3). It prints the authority signing key, its verification set and one
# credential per operator the synthetic policy names:
#   FRONTERA_OPERATOR_KEY_ADMIN, _PROVISIONER, _STEWARD, _APPROVER, _RESPONDER, _OBSERVER

# ---- Cutover only (compose.authority.yaml) ----
# true ONLY for the single start that creates the identity store; false again
# immediately after. A kit variable, never an AOC_ENTERPRISE_HUMAN_* one: before
# cutover the Host refuses every human-authority variable (AUTH-04A), and every
# line of this file reaches the Host's environment.
FRONTERA_AUTHORITY_INITIALIZE_IDENTITY=false
