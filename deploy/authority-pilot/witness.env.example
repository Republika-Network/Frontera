# Frontera Authority synthetic pilot — WITNESS machine settings (AUTH-04D2A).
#
#   cp deploy/authority-pilot/witness.env.example deploy/authority-pilot/.env.witness   (.env.* is gitignored)
#
# Never commit it. It holds no Host secret: only the witness's own id and the
# credential the Host presents to it.

# ---- Where the witness state lives (REQUIRED) ----
# The mount point of this machine's replicated block-storage volume. Never on a
# snapshot schedule shared with the Host; never restored together with the Host's data.
FRONTERA_WITNESS_DATA_DIR='<required: replicated volume mount point, e.g. /mnt/frontera-witness>'

# ---- From witness-init --witness-only (REQUIRED) ----
AOC_ENTERPRISE_AUTHORITY_FRESHNESS_WITNESS_ID='<required: from witness-init --witness-only>'
AOC_ENTERPRISE_AUTHORITY_FRESHNESS_TOKEN='<required-secret: from witness-init --witness-only>'
